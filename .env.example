# Superadmin: usado só na primeira execução para criar a conta.
# Depois a senha é trocada no painel (Minha conta) e os usuários são criados em Usuários.
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-um-valor-aleatorio-longo

# PostgreSQL do docker compose (o app monta a conexão sozinho).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=troque-esta-senha-do-banco

# Fora do Docker, informe a conexão (postgres://... também é aceito).
# Sem DATABASE_URL, usa SQLite em ./data/bot.db.
# DATABASE_URL=postgresql+asyncpg://bot:SENHA@localhost:5432/bot_telegram

TIMEZONE=America/Sao_Paulo

# Endereço público do painel (https). Habilita o webhook do Mercado Pago de cada usuário.
# PUBLIC_URL=https://bot.seudominio.com.br

# Com domínio e HTTPS (Caddy), ligue para o cookie de login só trafegar por HTTPS.
# Deixe 0 para acessar por http://localhost ou túnel SSH.
# Cookie só por HTTPS. Liga sozinho quando PUBLIC_URL começa com https://.
# COOKIE_SECURE=1

# Chave dos segredos gravados no banco (tokens, senhas). Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guarde uma cópia: sem ela, os segredos salvos ficam ilegíveis.
ENCRYPTION_KEY=

# Cada usuário configura no painel o próprio bot, o Mercado Pago, a chave Pix,
# os planos e as mensagens.
